// Central Team Platform — Phase 0 data model.
// See ARCHITECTURE.md §4 for the reasoning behind the non-obvious calls below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity, roles, permissions
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  avatar       String?
  status       UserStatus @default(ACTIVE)
  locale       String     @default("ar")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  // Null for internal agency staff. Set for client-portal users — this is the
  // field every client-scoping authorization check hinges on.
  clientId String?
  client   Client? @relation("ClientUsers", fields: [clientId], references: [id])

  managedClients        Client[]       @relation("AccountManager")
  ownedProjects         Project[]      @relation("ProjectOwner")
  managedProjects       Project[]      @relation("ProjectAccountManager")
  assignedTasks         Task[]         @relation("TaskAssignee")
  requestedRequests     Request[]      @relation("RequestedBy")
  assignedRequests      Request[]      @relation("RequestAssignee")
  ownedOpportunities    Opportunity[]  @relation("OpportunityOwner")
  assignedLeads         Lead[]         @relation("LeadAssignee")
  uploadedAssets        Asset[]        @relation("AssetUploadedBy")
  notifications         Notification[]
  comments              Comment[]
  approvalsRequested    Approval[]     @relation("ApprovalRequestedBy")
  approvalsDecided      Approval[]     @relation("ApprovalApprover")
  auditLogs             AuditLog[]
  connectedIntegrations Integration[]  @relation("IntegrationConnectedBy")

  // Phase 2: generic created-by/updated-by tracking, one pair of relations
  // per audited entity (distinct relation names since a user can appear in
  // more than one of these at once).
  clientsCreated   Client[]   @relation("ClientCreatedBy")
  clientsUpdated   Client[]   @relation("ClientUpdatedBy")
  contractsCreated Contract[] @relation("ContractCreatedBy")
  contractsUpdated Contract[] @relation("ContractUpdatedBy")
  projectsCreated  Project[]  @relation("ProjectCreatedBy")
  projectsUpdated  Project[]  @relation("ProjectUpdatedBy")

  // Phase 3
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([clientId])
  @@index([roleId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Phase 3: Departments (task/staff grouping — Design, Video, Web, ...)
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       User[]
  tasks         Task[]
  templateItems RequestTemplateItem[]
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. SUPER_ADMIN, ACCOUNT_MANAGER, PROJECT_MANAGER, STAFF, CLIENT_ADMIN, CLIENT_USER
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "clients.create", "projects.update"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------

model Client {
  id                     String       @id @default(cuid())
  companyName            String
  legalName              String?
  logo                   String?
  industry               String?
  website                String?
  email                  String?
  phone                  String?
  address                String?
  // Phase 2 additions — nullable so existing seeded clients stay valid.
  commercialRegistration String?
  taxNumber              String?
  country                String?
  city                   String?
  status                 ClientStatus @default(ACTIVE)
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  accountManagerId String?
  accountManager   User?   @relation("AccountManager", fields: [accountManagerId], references: [id])

  createdById String?
  createdBy   User?   @relation("ClientCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ClientUpdatedBy", fields: [updatedById], references: [id])

  users         User[]          @relation("ClientUsers")
  contacts      ClientContact[]
  contracts     Contract[]
  projects      Project[]
  requests      Request[]
  leads         Lead[]
  opportunities Opportunity[]
  assets        Asset[]
  integrations  Integration[]
  auditLogs     AuditLog[]

  @@index([accountManagerId])
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  ON_HOLD
  ARCHIVED
}

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

model ClientContact {
  id                     String         @id @default(cuid())
  clientId               String
  client                 Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                   String
  email                  String?
  phone                  String?
  whatsapp               String?
  // "Job title" — kept as `position` (pre-existing column) rather than
  // renamed, so no data migration is needed for already-seeded contacts.
  position               String?
  department             String?
  preferredContactMethod ContactMethod?
  notes                  String?
  status                 ContactStatus  @default(ACTIVE)
  isPrimary              Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([clientId])
}

model Contract {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  contractNumber String?        @unique
  type           String?
  startDate      DateTime?
  endDate        DateTime?
  value          Decimal?       @db.Decimal(14, 2)
  currency       String?        @default("SAR")
  paymentTerms   String?
  status         ContractStatus @default(DRAFT)
  fileUrl        String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  createdById String?
  createdBy   User?   @relation("ContractCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ContractUpdatedBy", fields: [updatedById], references: [id])

  projects Project[]

  @@index([clientId])
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

model ProjectType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
}

model Project {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractId    String?
  contract      Contract?   @relation(fields: [contractId], references: [id])
  projectTypeId String
  projectType   ProjectType @relation(fields: [projectTypeId], references: [id])

  name        String
  // Short human-readable reference (e.g. "PRJ-0042") — nullable/unique so it
  // can be assigned to existing projects without a backfill migration.
  projectCode String?       @unique
  description String?
  status      ProjectStatus @default(PLANNED)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  budget      Decimal?      @db.Decimal(14, 2)
  currency    String?       @default("SAR")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id])

  accountManagerId String?
  accountManager   User?   @relation("ProjectAccountManager", fields: [accountManagerId], references: [id])

  createdById String?
  createdBy   User?   @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])

  scopes        ProjectScope[]
  requests      Request[]
  tasks         Task[]
  deliverables  Deliverable[]
  campaigns     Campaign[]
  leads         Lead[]
  opportunities Opportunity[]
  assets        Asset[]
  auditLogs     AuditLog[]

  @@index([clientId])
  @@index([projectTypeId])
  @@index([ownerId])
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ProjectScope {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    Int         @default(1)
  status     ScopeStatus @default(DRAFT)
  approvedAt DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items ScopeItem[]

  @@index([projectId])
}

enum ScopeStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model ScopeItem {
  id             String       @id @default(cuid())
  projectScopeId String
  projectScope   ProjectScope @relation(fields: [projectScopeId], references: [id], onDelete: Cascade)

  category              ScopeItemCategory
  name                  String
  description           String?
  quantity              Int?              @default(1)
  unit                  String?
  estimatedHours        Decimal?          @db.Decimal(8, 2)
  included              Boolean           @default(true)
  status                ScopeItemStatus   @default(PLANNED)
  // How `quantity`'s completed/remaining split is derived — see
  // src/lib/scope-progress.ts. Defaults to QUANTITY so every pre-existing
  // scope item keeps behaving exactly as it did before this field existed.
  progressMode          ScopeProgressMode @default(QUANTITY)
  // Only meaningful when progressMode = MANUAL.
  manualProgressPercent Int?
  // Only meaningful when progressMode = WEIGHTED — this item's share of the
  // category's total weight, instead of its raw quantity.
  weight                Decimal?          @db.Decimal(6, 2)
  startDate             DateTime?
  dueDate               DateTime?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tasks    Task[]
  requests Request[]

  @@index([projectScopeId])
}

enum ScopeProgressMode {
  // completed/total quantity, e.g. "6 of 10 designs" — the existing (and
  // still default) behavior.
  QUANTITY
  // derived from the linked Tasks' statuses instead of a raw quantity.
  TASK_BASED
  // an admin-entered percent (manualProgressPercent), for scope that isn't
  // naturally countable.
  MANUAL
  // like QUANTITY, but this item's contribution to the category rollup is
  // scaled by `weight` instead of its quantity.
  WEIGHTED
}

enum ScopeItemCategory {
  DESIGN
  VIDEO
  VOICE_OVER
  COPYWRITING
  PHOTOGRAPHY
  BROCHURE
  WEBSITE
  LANDING_PAGE
  SEO
  MARKETING_STRATEGY
  ADVERTISING
  MEDIA_BUYING
  COMMUNITY_MANAGEMENT
  LEAD_GENERATION
  SALES_SUPPORT
  REPORTING
  PRESENTATION
  OTHER
}

enum ScopeItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Requests, Tasks, Deliverables, Assets
// ---------------------------------------------------------------------------

model RequestType {
  id          String             @id @default(cuid())
  name        String             @unique
  description String?
  // Drives which extra fields the "new request" form shows (dimensions for a
  // design request, duration/script for video, ...) without fuzzy-matching
  // on the free-text name. Null = generic request, no extra fields.
  category    ScopeItemCategory?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  requests Request[]
}

model Request {
  id            String      @id @default(cuid())
  requestNumber Int         @default(autoincrement())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id])
  requestTypeId String
  requestType   RequestType @relation(fields: [requestTypeId], references: [id])
  scopeItemId   String?
  scopeItem     ScopeItem?  @relation(fields: [scopeItemId], references: [id])
  campaignId    String?
  campaign      Campaign?   @relation(fields: [campaignId], references: [id])

  title         String
  description   String?
  status        RequestStatus @default(NEW)
  priority      Priority      @default(MEDIUM)
  requestedDate DateTime?
  dueDate       DateTime?
  // Request-type-specific fields (design dimensions, video duration, campaign
  // budget, ...) that don't warrant their own rarely-populated columns.
  metadata      Json?
  // Internal-only notes — never selected/rendered on any portal/* query
  // (same visibility precedent as Task.clientVisible, just field-shaped
  // instead of a boolean since the whole column is agency-internal).
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  requestedById String?
  requestedBy   User?   @relation("RequestedBy", fields: [requestedById], references: [id])

  // "Assigned Manager" in the spec — kept as the pre-existing assignedTo
  // relation rather than adding a second field for the same concept.
  assignedToId String?
  assignedTo   User?   @relation("RequestAssignee", fields: [assignedToId], references: [id])

  tasks  Task[]
  assets Asset[]

  @@index([clientId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([campaignId])
}

enum RequestStatus {
  NEW
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  INTERNAL_REVIEW
  CLIENT_REVIEW
  CHANGES_REQUIRED
  COMPLETED
  ARCHIVED
}

model Task {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopeItemId  String?
  scopeItem    ScopeItem?  @relation(fields: [scopeItemId], references: [id])
  // Which client Request this task executes — nullable so standalone
  // project-level tasks (not tied to a client request) keep working.
  requestId    String?
  request      Request?    @relation(fields: [requestId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  estimatedHours Decimal?   @db.Decimal(6, 2)
  actualHours    Decimal?   @db.Decimal(6, 2)
  startDate      DateTime?
  dueDate        DateTime?
  notes          String?
  // Internal-only tasks (e.g. "internal QA pass") stay off the client portal;
  // everything else is visible there by default. See ARCHITECTURE.md.
  clientVisible  Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  deliverables Deliverable[]
  assets       Asset[]

  // Dependency graph: this task's prerequisites, and the tasks that name
  // this one as a prerequisite. See TaskDependency below.
  dependsOn   TaskDependency[] @relation("TaskDependents")
  blockingFor TaskDependency[] @relation("TaskPrerequisites")

  @@index([projectId])
  @@index([assigneeId])
  @@index([requestId])
  @@index([departmentId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  INTERNAL_REVIEW
  CLIENT_REVIEW
  CHANGES_REQUIRED
  COMPLETED
  CANCELLED
  ARCHIVED
}

// Directed edge: `task` cannot start until `dependsOnTask` is COMPLETED.
// A dedicated join table (rather than a self-relation array field) because
// the relation is many-to-many in both directions and needs its own
// identity for cycle/unmet-dependency checks in src/lib/task-dependencies.ts.
model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation("TaskDependents", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task     @relation("TaskPrerequisites", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
}

// A named, ordered set of task drafts a Request Type suggests (e.g. "Video
// Template": Script -> Script Review -> Voice Over -> ...). Applying a
// template only ever pre-fills the task-generation draft screen — nothing
// here is created as a real Task until the user reviews/edits and submits.
model RequestTemplate {
  id          String             @id @default(cuid())
  name        String
  category    ScopeItemCategory?
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  items RequestTemplateItem[]
}

model RequestTemplateItem {
  id         String          @id @default(cuid())
  templateId String
  template   RequestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  order                 Int
  title                 String
  description           String?
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id])
  defaultPriority       Priority    @default(MEDIUM)
  defaultEstimatedHours Decimal?    @db.Decimal(6, 2)
  // `order` value of another item in the SAME template that must complete
  // first — resolved into a real TaskDependency only once tasks are
  // generated from this template (see generateTasksFromTemplateAction).
  dependsOnOrder        Int?

  @@index([templateId])
}

model Deliverable {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id])

  title       String
  description String?
  type        String?
  // Reuses ScopeItemCategory so deliverables filter/group the same way scope
  // items do, instead of a parallel taxonomy on the free-text `type` field
  // (which stays for the file format, e.g. "PDF").
  category    ScopeItemCategory?
  status      DeliverableStatus  @default(DRAFT)
  version     Int                @default(1)
  dueDate     DateTime?
  deliveredAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  assets Asset[]

  // Versioning: uploading a new version creates a NEW Deliverable row linked
  // back to the one it replaces — the old row is never overwritten, so the
  // full v1/v2/v3 history stays queryable. See ARCHITECTURE.md.
  supersedesId String?      @unique
  supersedes   Deliverable? @relation("DeliverableVersions", fields: [supersedesId], references: [id])
  nextVersion  Deliverable? @relation("DeliverableVersions")

  @@index([projectId])
  @@index([taskId])
}

enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  DELIVERED
  REJECTED
}

model Asset {
  id            String       @id @default(cuid())
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id])
  deliverableId String?
  deliverable   Deliverable? @relation(fields: [deliverableId], references: [id])
  taskId        String?
  task          Task?        @relation(fields: [taskId], references: [id])
  requestId     String?
  request       Request?     @relation(fields: [requestId], references: [id])

  fileName  String
  fileUrl   String
  fileType  String?
  fileSize  Int?
  createdAt DateTime @default(now())

  uploadedById String?
  uploadedBy   User?   @relation("AssetUploadedBy", fields: [uploadedById], references: [id])

  @@index([clientId])
  @@index([projectId])
  @@index([deliverableId])
  @@index([taskId])
  @@index([requestId])
}

// ---------------------------------------------------------------------------
// Optional project components: Campaign, Lead, Opportunity
// ---------------------------------------------------------------------------

model Campaign {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  platform  CampaignPlatform
  status    CampaignStatus   @default(PLANNED)
  objective String?
  budget    Decimal?         @db.Decimal(14, 2)
  currency  String?          @default("SAR")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  leads    Lead[]
  requests Request[]
  metric   CampaignMetric?

  @@index([projectId])
}

// A stored metrics snapshot per campaign. No live ad-platform sync yet (that's
// what the still-unused Integration model is for, later) — this is populated
// by seed data / a future manual or synced update. CTR/CPC/CPL/ROAS are
// derived in code (src/lib/campaign-metrics.ts), not stored, so they can
// never drift out of sync with the raw numbers.
model CampaignMetric {
  id          String   @id @default(cuid())
  campaignId  String   @unique
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  spend       Decimal  @default(0) @db.Decimal(14, 2)
  impressions Int      @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(14, 2)
  currency    String   @default("SAR")
  updatedAt   DateTime @updatedAt
}

enum CampaignPlatform {
  META
  GOOGLE
  TIKTOK
  SNAPCHAT
  LINKEDIN
  X
  OTHER
}

enum CampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Lead {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  name      String
  email     String?
  phone     String?
  source    String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id])

  opportunities Opportunity[]

  @@index([clientId])
  @@index([projectId])
  @@index([campaignId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DISQUALIFIED
  CONVERTED
}

model Opportunity {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])

  title             String
  stage             OpportunityStage  @default(NEW)
  value             Decimal?          @db.Decimal(14, 2)
  currency          String?           @default("SAR")
  probability       Int?
  expectedCloseDate DateTime?
  status            OpportunityStatus @default(OPEN)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ownerId String?
  owner   User?   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  @@index([clientId])
  @@index([projectId])
  @@index([leadId])
}

enum OpportunityStage {
  NEW
  QUALIFYING
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

// ---------------------------------------------------------------------------
// Cross-cutting: Notification, Comment, Approval, Integration, AuditLog
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Polymorphic association via entityType + entityId — no DB-level FK, enforced
// in application code. See ARCHITECTURE.md §4.
enum CommentableType {
  PROJECT
  TASK
  REQUEST
  DELIVERABLE
  OPPORTUNITY
}

model Comment {
  id         String          @id @default(cuid())
  entityType CommentableType
  entityId   String
  authorId   String
  author     User            @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([entityType, entityId])
  @@index([authorId])
}

enum ApprovableType {
  PROJECT_SCOPE
  DELIVERABLE
  CONTRACT
}

model Approval {
  id         String         @id @default(cuid())
  entityType ApprovableType
  entityId   String
  status     ApprovalStatus @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  requestedById String?
  requestedBy   User?   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])

  approverId String?
  approver   User?   @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([entityType, entityId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Integration {
  id          String              @id @default(cuid())
  clientId    String?
  client      Client?             @relation(fields: [clientId], references: [id])
  provider    IntegrationProvider
  status      IntegrationStatus   @default(DISCONNECTED)
  credentials Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  connectedById String?
  connectedBy   User?   @relation("IntegrationConnectedBy", fields: [connectedById], references: [id])

  @@index([clientId])
}

enum IntegrationProvider {
  META_ADS
  GOOGLE_ADS
  GOOGLE_ANALYTICS
  TIKTOK_ADS
  WHATSAPP
  OTHER
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  // Denormalized so "all activity for project X" (the portal Activity tab) is
  // a single indexed query instead of a join across every entity type that
  // can belong to a project. Null for logs about entities that aren't
  // project-scoped (e.g. Client-level actions).
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  // Same denormalization for "all activity for client X" (Client 360
  // Activity tab), set on every log about the client itself or anything
  // owned by it (contacts, contracts, projects).
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([projectId])
  @@index([clientId])
}
